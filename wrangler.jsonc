{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "estruturadaescuta",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Só a API passa pelo código; o resto são arquivos servidos direto.
    "run_worker_first": ["/api/*", "/adm/api/*"]
  },
  // O login da área usa as funções públicas do desafio no banco do Habitar,
  // com a chave publicável (a mesma que o /escuta usa no navegador).
  "vars": {
    "SUPABASE_URL": "https://xecshgdpzrxoyerlhicf.supabase.co",
    "SUPABASE_CHAVE": "sb_publishable_BwjQdU7LU_zFmuPpUx3qAw_tvfJ8lxz"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estruturadaescuta",
      "database_id": "7f600446-b098-402b-b506-8d22df1d76b8"
    }
  ]
}
